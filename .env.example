# Python uses the real OpenAI Batch API. Fill in your key and chosen model.
# Copy to .env; the Python CLI loads it automatically. Exported values take precedence.
NEXUS_BATCH_MODE=live
OPENAI_API_KEY=
OPENAI_MODEL=

TEMPORAL_ADDRESS=127.0.0.1:7234
TEMPORAL_NAMESPACE=default
PYTHON_DATABASE_URL=postgres://nexus_batch:nexus_batch@127.0.0.1:54329/nexus_batch_python?sslmode=disable
# Go uses this database; export its variables when using the Go CLI.
DATABASE_URL=postgres://nexus_batch:nexus_batch@127.0.0.1:54329/nexus_batch?sslmode=disable
